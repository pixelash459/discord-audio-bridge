root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 110

[*.{cs,csproj,sln}]
indent_size = 4

[*.{ps1,psm1}]
indent_size = 4
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
