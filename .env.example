# ---- Discord ----------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Optional. Resolved from the bot token automatically; set it only when the token and the
# application are deliberately different.
DISCORD_APP_ID=
# Optional: register slash commands instantly to one guild instead of globally
# (global registration can take up to an hour to propagate)
DISCORD_GUILD_ID=

# ---- Audio ------------------------------------------------------------------
# Opus target bitrate in bits/sec. Leave blank to auto-match the voice channel's
# bitrate (which is capped by the server's boost tier: 96k none / 128k tier1 /
# 256k tier2 / 384k tier3).
OPUS_BITRATE=
# off | on | constrained.  "on" = unconstrained VBR = best quality.
OPUS_VBR=on
# 0-10. 10 = best quality, most CPU. libopus default is already 10.
OPUS_COMPLEXITY=10
# Jitter buffer in the capture helper, in ms. Higher = more robust, more latency.
CAPTURE_BUFFER_MS=120
# off = no processing; limit = true-peak protection; match = EBU R128 matching + limiter.
AUDIO_LOUDNESS=limit
AUDIO_TARGET_LUFS=-14
AUDIO_TRUE_PEAK_DB=-1

# ---- Presence and automation ------------------------------------------------
PRESENCE_ACTIVITY=true
PRESENCE_CHANNEL_STATUS=true
PRESENCE_NOW_PLAYING=true
# Stop after this many seconds with no human listeners. 0 disables automatic leaving.
AUTO_LEAVE_SECONDS=0
# Restore the last successful route after sign-in. Disabled until explicitly opted in.
# Move a live stream to whichever voice channel this Discord user joins. Never
# starts a stream on its own. Leave blank to disable.
AUTO_FOLLOW_USER_ID=
AUTO_RESUME=false

# ---- Control panel ----------------------------------------------------------
# Port for the local control panel (HTTP + WebSocket, bound to 127.0.0.1 only).
# Set to 0 to disable it and use slash commands only.
CONTROL_PORT=8787
# Open the panel in your default browser when the bot starts.
CONTROL_OPEN=false

# ---- Remote control ---------------------------------------------------------
# Restricted runtime-only dashboard for phones and other LAN/Tailscale devices.
# It has its own persistent access token in .remote-token and cannot edit setup credentials.
# Disabled by default. To opt in, set REMOTE_PORT=8788 and bind either one trusted interface or
# 0.0.0.0 for every LAN/Tailscale IPv4 interface.
REMOTE_HOST=127.0.0.1
REMOTE_PORT=0
# Allow peers verified by the local Tailscale daemon (`tailscale whois`) without a second app token.
# LAN access still needs the token. Set false if the tailnet is not entirely under your control.
REMOTE_TRUST_TAILSCALE=false
# Optional fixed secret; normally leave blank and use the generated .remote-token file/printed URL.
REMOTE_TOKEN=

# ---- Paths ------------------------------------------------------------------
# Leave blank to use whatever is on PATH.
FFMPEG_PATH=
# Leave blank to use native/AudioTap/bin/AudioTap.exe (Windows).
AUDIOTAP_PATH=
# Linux capture tools; leave blank to use pw-record / pw-dump from PATH.
# Player used for the "Monitor" button, which plays the encoded stream back on
# this machine. Ships with a full ffmpeg build; leave blank to use PATH.
FFPLAY_PATH=
PWRECORD_PATH=
PWDUMP_PATH=

# ---- Logging ----------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info
# UTF-8 JSON-lines log path, relative to the writable runtime root. Set to off to disable disk logging.
LOG_FILE=logs/bridge.log
