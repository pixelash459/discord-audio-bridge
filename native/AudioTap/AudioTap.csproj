<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows-only by construction: WASAPI process loopback has no cross-platform equivalent. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Run on newer supported .NET runtimes too; release packages remain self-contained. -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AudioTap</AssemblyName>
    <RootNamespace>AudioTap</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WASAPI COM activation is happiest on an MTA thread -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- NAudio 3 is the first version whose WasapiRecorderBuilder exposes
         WithProcessLoopback(), i.e. ActivateAudioInterfaceAsync +
         AUDIOCLIENT_PROCESS_LOOPBACK_PARAMS. Pinned because it is prerelease. -->
    <PackageReference Include="NAudio.Wasapi" Version="3.0.2-preview.1" />
  </ItemGroup>

</Project>
