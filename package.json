{
  "name": "discord-audio-bridge",
  "version": "1.5.0",
  "description": "Streams applications, devices, or live mixes from Windows into Discord voice channels.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "register": "node src/register.ts",
    "typecheck": "tsc --noEmit",
    "lint:web": "html-validate web/index.html remote/index.html && node --check web/boot-guard.js && node --check web/app.js && node --check remote/app.js",
    "build:native": "powershell -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "doctor": "node src/doctor.ts",
    "build:app": "powershell -ExecutionPolicy Bypass -File scripts/build-app.ps1",
    "app": "powershell -ExecutionPolicy Bypass -File scripts/build-app.ps1 -Run",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build:sea": "node scripts/build-sea.mjs",
    "icon": "node scripts/gen-icon.mjs",
    "package": "node scripts/package.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:http": "node scripts/http-smoke.mjs"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@noble/ciphers": "^2.4.0",
    "discord.js": "^14.27.0",
    "prism-media": "^1.3.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "html-validate": "^11.16.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
